/dts-v1/;

/* 4.4 exynos7885-rmem.dtsi: firmware-owned DRAM, never given to Linux. */
/memreserve/ 0xE0000000 0xD00000;

/ {
	compatible = "samsung, M20 SWA OPEN rev03\0samsung,Universal7904\0samsung,m20lte\0samsung,exynos7904";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Samsung Galaxy M20 (m20lte) bring-up on Exynos 7904";
	model_info-chip = <0x1ecd>;
	model_info-platform = "android";
	model_info-subtype = "samsung";
	model_info-hw_rev = <0x04>;
	model_info-hw_rev_end = <0xff>;

	pinctrl@148f0000 {
		compatible = "samsung,exynos7885-pinctrl";
		reg = <0x00 0x148f0000 0x00 0x1000>;
		interrupts = <0x00 0x82 0x04>;
		power-domains = <0x02>;

		gpb0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpb1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpb2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		aud-codec-mclk {
			samsung,pins = "gpb0-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			phandle = <0x28>;
		};

		aud-codec-mclk-idle {
			samsung,pins = "gpb0-0";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2d>;
		};

		aud-codec-bus {
			samsung,pins = "gpb0-1\0gpb0-2\0gpb0-3\0gpb0-4";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			phandle = <0x29>;
		};

		aud-codec-bus-idle {
			samsung,pins = "gpb0-1\0gpb0-2\0gpb0-3\0gpb0-4";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2e>;
		};

		aud-fm-bus {
			samsung,pins = "gpb1-1\0gpb1-2\0gpb1-3";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2a>;
		};

		aud-fm-bus-idle {
			samsung,pins = "gpb1-1\0gpb1-2\0gpb1-3";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2f>;
		};

		aud-spk-bus {
			samsung,pins = "gpb2-0\0gpb2-1\0gpb2-2\0gpb2-3";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2b>;
		};

		aud-spk-bus-idle {
			samsung,pins = "gpb2-0\0gpb2-1\0gpb2-2\0gpb2-3";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x30>;
		};

		aud-loopback-bus {
			samsung,pins = "gpb1-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			phandle = <0x2c>;
		};

		aud-loopback-bus-idle {
			samsung,pins = "gpb1-0";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			phandle = <0x31>;
		};
	};

	pinctrl@13430000 {
		compatible = "samsung,exynos7885-pinctrl";
		reg = <0x00 0x13430000 0x00 0x1000>;
		interrupts = <0x00 0x96 0x04>;

		gpf0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpf2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpf3 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpf4 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		sd0-clk {
			samsung,pins = "gpf0-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x03>;
			phandle = <0x06>;
		};

		sd0-cmd {
			samsung,pins = "gpf0-1";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x03>;
			phandle = <0x07>;
		};

		sd0-rdqs {
			samsung,pins = "gpf0-2";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			samsung,pin-drv = <0x03>;
			phandle = <0x08>;
		};

		sd0-bus-width8 {
			samsung,pins = "gpf2-0\0gpf2-1\0gpf2-2\0gpf2-3\0gpf2-4\0gpf2-5\0gpf2-6\0gpf2-7";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x03>;
			phandle = <0x09>;
		};
	};

	pinctrl@139b0000 {
		compatible = "samsung,exynos7885-pinctrl";
		reg = <0x00 0x139b0000 0x00 0x1000>;
		interrupts = <0x00 0x10a 0x04>;

		gpp0 {
			phandle = <0x7f03>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;


		};

		gpg0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp3 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp4 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp5 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp6 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp7 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpp8 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		gpg1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x3b>;
		};

		gpg2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x15>;
		};

		gpg3 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x37>;
		};

		gpg4 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x38>;
		};

		gpc0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x24>;
		};

		gpc1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		hs-i2c4-bus {
			samsung,pins = "gpc2-1\0gpc2-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			samsung,pin-con-pdn = <0x01>;
			samsung,pin-pud-pdn = <0x03>;
			phandle = <0x11>;
		};

		hs-i2c5-bus {
			samsung,pins = "gpc2-3\0gpc2-2";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			samsung,pin-con-pdn = <0x01>;
			samsung,pin-pud-pdn = <0x03>;
			phandle = <0x12>;
		};

		gpc2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
		};

		decon_f_te_on {
			samsung,pins = "gpc0-3";
			samsung,pin-function = <0x0f>;
			phandle = <0x22>;
		};

		decon_f_te_off {
			samsung,pins = "gpc0-3";
			samsung,pin-function = <0x00>;
			phandle = <0x23>;
		};

		i2c4-bus {
			samsung,pins = "gpp4-1\0gpp4-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x1b>;
		};

		i2c5-bus {
			samsung,pins = "gpp4-3\0gpp4-2";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			phandle = <0x1c>;
		};

		i2c6-bus {
			samsung,pins = "gpp4-5\0gpp4-4";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			phandle = <0x1d>;
		};

		grip-i2c {
			samsung,pins = "gpp7-1\0gpp7-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
		};

		grip-gpio {
			samsung,pins = "gpp7-1\0gpp7-0";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
		};

		i2c0-bus {
			samsung,pins = "gpp1-1\0gpp1-0";
			samsung,pin-function = <0x02>;
			samsung,pin-con-pdn = <0x03>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x16>;
		};

		i2c1-bus {
			samsung,pins = "gpp1-3\0gpp1-2";
			samsung,pin-function = <0x02>;
			samsung,pin-con-pdn = <0x03>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x19>;
		};

		uart0-bus {
			samsung,pins = "gpp0-2\0gpp0-1\0gpp0-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x00>;
			phandle = <0x10>;
		};

		i2c3-bus {
			samsung,pins = "gpp3-1\0gpp3-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x36>;
		};
	};

	power-domain@11c84020 {
		compatible = "samsung,exynos7885-dispaud-pd";
		reg = <0x00 0x11c84020 0x00 0x20>;
		#power-domain-cells = <0x00>;
		samsung,pmu = <0x03>;
		need_smc = <0x148f0000>;
		status = "okay";
		phandle = <0x02>;
	};

	power-domain@11c840a0 {
		compatible = "samsung,exynos7885-g3d-pd";
		reg = <0x00 0x11c840a0 0x00 0x20>;
		#power-domain-cells = <0x00>;
		samsung,pmu = <0x03>;
		status = "okay";
		phandle = <0x7f00>;
	};

	pinctrl@11CB0000 {
		compatible = "samsung,exynos7885-pinctrl";
		reg = <0x00 0x11cb0000 0x00 0x1000>;
		interrupts = <0x00 0x00 0x04 0x00 0x01 0x04 0x00 0x02 0x04 0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04 0x00 0x06 0x04 0x00 0x07 0x04 0x00 0x08 0x04 0x00 0x09 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04 0x00 0x0c 0x04 0x00 0x0d 0x04 0x00 0x0e 0x04 0x00 0x0f 0x04>;

		gpa0 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			/* direct wakeup EINTs: 5.10 reads them per bank, 4.4 had them on the parent */
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x00 0x04>, <0x00 0x01 0x04>, <0x00 0x02 0x04>, <0x00 0x03 0x04>, <0x00 0x04 0x04>, <0x00 0x05 0x04>, <0x00 0x06 0x04>, <0x00 0x07 0x04>;
			phandle = <0x14>;
		};

		m20_gpa1: gpa1 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x08 0x04>, <0x00 0x09 0x04>, <0x00 0x0a 0x04>, <0x00 0x0b 0x04>, <0x00 0x0c 0x04>, <0x00 0x0d 0x04>, <0x00 0x0e 0x04>, <0x00 0x0f 0x04>;
		};

		m20_key_power: key-power {
			samsung,pins = "gpa1-7";
			samsung,pin-function = <0x0f>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
		};

		m20_key_voldown: key-voldown {
			samsung,pins = "gpa1-6";
			samsung,pin-function = <0x0f>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
		};

		m20_key_volup: key-volup {
			samsung,pins = "gpa1-5";
			samsung,pin-function = <0x0f>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
		};

		attn-irq {
			samsung,pins = "gpa0-0";
			samsung,pin-function = <0x0f>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			phandle = <0x13>;
		};

		gpa2 {
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			#address-cells = <0x00>;
			phandle = <0x0a>;
		};

		wakeup-interrupt-controller {
			compatible = "samsung,exynos7-wakeup-eint";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x10 0x04>;
			samsung,eint-flt-conf;
		};

		fuel-irq {
			samsung,pins = "gpa2-4";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x02>;
			samsung,pin-drv = <0x00>;
			phandle = <0x17>;
		};

		if-pmic-irq {
			samsung,pins = "gpa2-2";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			phandle = <0x1a>;
		};

		usbpd-irq {
			samsung,pins = "gpa2-3";
			samsung,pin-function = <0x0f>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x00>;
			phandle = <0x18>;
		};
	};

	chipid@10000000 {
		compatible = "samsung,exynos7885-chipid";
		reg = <0x00 0x10000000 0x00 0x100>;
	};

	wifi@120c0000 {
		compatible = "samsung,scsc_wifibt";
		reg = <0x00 0x120c0000 0x00 0x180 0x00 0x120e0000 0x00 0x180>;
		interrupts = <0x00 0x39 0x04 0x00 0x15 0x04 0x00 0x11e 0x04>;
		interrupt-names = "MBOX\0ALIVE\0WDOG";
		samsung,syscon-phandle = <0x03>;
		status = "okay";
	};

	aliases {
		serial0 = "/serial@13800000";
		i2c0 = "/i2c@13830000";
		i2c1 = "/i2c@13840000";
		i2c11 = "/i2c@13860000";
		pinctrl0 = "/pinctrl@11CB0000";
		pinctrl1 = "/pinctrl@148f0000";
		pinctrl2 = "/pinctrl@13430000";
		pinctrl3 = "/pinctrl@139b0000";
		mmc0 = "/dwmmc0@13500000";
		dpp0 = "/dpp@148b1000";
		dpp1 = "/dpp@148b2000";
		dpp2 = "/dpp@148b4000";
		dpp3 = "/dpp@148b3000";
		dsim0 = "/dsim@14870000";
		decon0 = "/decon_f@14860000";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x100>;
			enable-method = "psci";
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x101>;
			enable-method = "psci";
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x102>;
			enable-method = "psci";
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x103>;
			enable-method = "psci";
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x200>;
			enable-method = "psci";
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			capacity-dmips-mhz = <592>;
			reg = <0x00 0x201>;
			enable-method = "psci";
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			capacity-dmips-mhz = <1024>;
			reg = <0x00 0x00>;
			enable-method = "psci";
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			capacity-dmips-mhz = <1024>;
			reg = <0x00 0x01>;
			enable-method = "psci";
		};
	};

	tee {
		compatible = "samsung,exynos-tee";
		interrupts = <0x00 0xdf 0x01>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	/*
	 * 4.4 mct@10040000 (SPI 234..245: 4 global + 8 local comparators).
	 * MCT keeps running while a core is powered down by cpuidle C2,
	 * which stops that core's ARM generic timer.
	 */
	mct@10040000 {
		compatible = "samsung,exynos4210-mct";
		reg = <0x00 0x10040000 0x00 0x800>;
		interrupts = <0x00 0xea 0x04 0x00 0xeb 0x04 0x00 0xec 0x04 0x00 0xed 0x04 0x00 0xee 0x04 0x00 0xef 0x04 0x00 0xf0 0x04 0x00 0xf1 0x04 0x00 0xf2 0x04 0x00 0xf3 0x04 0x00 0xf4 0x04 0x00 0xf5 0x04>;
		clocks = <0x04 0x01 0x04 0x48>;
		clock-names = "fin_pll", "mct";
		use-clockevent-only;
		/* v202/v203 hung ~7 s into boot with MCT ticks; off until debugged. */
		status = "disabled";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		clock-frequency = <0x18cba80>;
	};

	clock-controller@12060000 {
		compatible = "samsung,exynos7885-clock";
		reg = <0x00 0x12060000 0x00 0x8000 0x00 0x10010000 0x00 0x8000 0x00 0x13400000 0x00 0x8000 0x00 0x11c00000 0x00 0x8000 0x00 0x14800000 0x00 0x8000 0x00 0x12000000 0x00 0x8000>;
		reg-names = "cmu\0peri\0fsys\0apm\0dispaud\0core";
		#clock-cells = <0x01>;
		phandle = <0x04>;
	};

	bts@12460000 {
		compatible = "samsung,exynos7885-bts";
		reg = <0x00 0x12460000 0x00 0x800 0x00 0x124a0000 0x00 0x800 0x00 0x12450000 0x00 0x800 0x00 0x12470000 0x00 0x800 0x00 0x12480000 0x00 0x800 0x00 0x12490000 0x00 0x800 0x00 0x124c0000 0x00 0x800 0x00 0x124b0000 0x00 0x800 0x00 0x12420000 0x00 0x800 0x00 0x12440000 0x00 0x800 0x00 0x12400000 0x00 0x800 0x00 0x10480000 0x00 0x800 0x00 0x10580000 0x00 0x800 0x00 0x10400000 0x00 0x1000 0x00 0x10500000 0x00 0x1000>;
		reg-names = "g3d\0mfcmscl\0fsys\0gnss\0isp0\0isp1\0wlbt\0cp\0cam\0dpu\0abox\0cpu_dmc0\0cpu_dmc1\0drex0\0drex1";
		status = "disabled";
	};

	sysmmu@148c0000 {
		compatible = "samsung,exynos7885-sysmmu";
		reg = <0x00 0x148c0000 0x00 0x9000>;
		interrupts = <0x00 0x80 0x01 0x00 0x7f 0x01>;
		qos = <0x0f>;
		clock-names = "aclk";
		clocks = <0x04 0xd4>;
		power-domains = <0x02>;
		port-name = "DPU (GF, G0, G1, VG)";
		sysmmu,secure-irq;
		sysmmu,secure_base = <0x148d0000>;
		sysmmu,tlb_property = <0x10a 0x00 0x1010a 0xffff0001 0x1010a 0xffff0000 0x1010a 0xffff0002 0x1010a 0xffff0006 0x1010a 0xffff0008>;
		dma-window = <0x10000000 0xefff0000>;
		#iommu-cells = <0x00>;
		status = "disabled";
		phandle = <0x1e>;
	};

	interrupt-controller@12301000 {
		compatible = "arm,cortex-a15-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0x12301000 0x00 0x1000 0x00 0x12302000 0x00 0x1000 0x00 0x12304000 0x00 0x2000 0x00 0x12306000 0x00 0x2000>;
		interrupts = <0x01 0x09 0xff04>;
		phandle = <0x01>;
	};

	smu {
		compatible = "samsung,exynos-smu";
		phandle = <0x05>;
	};

	dwmmc0@13500000 {
		compatible = "samsung,exynos-dw-mshc";
		reg = <0x00 0x13500000 0x00 0x2000 0x00 0x13508000 0x00 0x200>;
		reg-names = "dw_mmc\0cmdq_mem";
		interrupts = <0x00 0x92 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x04 0xfb 0x04 0x108>;
		clock-names = "biu\0ciu";
		mmc-exynos-smu = <0x05>;
		status = "okay";
		bus-width = <0x08>;
		non-removable;
		/* HS200 tuning, then HS400 (4.4 used enhanced strobe; 5.10 dw_mmc has none) */
		cap-mmc-highspeed;
		mmc-hs200-1_8v;
		/* v209: HS400 alone (C2 only on A73) to isolate the v204 hang */
		mmc-hs400-1_8v;
		/* v223: keep the eMMC awake across SoC sleep (4.4 Samsung flag) */
		pm-skip-mmc-resume-init;
		max-frequency = <200000000>;
		fifo-depth = <0x40>;
		card-detect-delay = <0xc8>;
		samsung,dw-mshc-ciu-div = <0x03>;
		samsung,dw-mshc-sdr-timing = <0x03 0x00 0x04 0x00>;
		samsung,dw-mshc-ddr-timing = <0x03 0x00 0x04 0x02>;
		samsung,dw-mshc-hs200-timing = <0x03 0x00 0x03 0x00>;
		samsung,dw-mshc-hs400-timing = <0x01 0x00 0x02 0x00>;
		samsung,dw-mshc-hs400-delay-line = <0x90>;
		samsung,dw-mshc-txdt-crc-timer-fastlimit = <0x13>;
		samsung,dw-mshc-txdt-crc-timer-initval = <0x15>;
		pinctrl-names = "default";
		pinctrl-0 = <0x06 0x07 0x08 0x09>;
	};

	i2c@11ce0000 {
		compatible = "samsung,exynos-speedy";
		reg = <0x00 0x11ce0000 0x00 0x2000>;
		interrupts = <0x00 0x22 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x04 0x133>;
		clock-names = "gate_speedy";
		status = "okay";

		pmic@0 {
			compatible = "samsung,s2mpu08-pmic\0samsung,s2mpu08mfd";
			reg = <0x00>;
			i2c-speedy-address;
			acpm-ipc-channel = <0x02>;
			s2mpu08,irq-gpio = <0x0a 0x00 0x00>;
			wakeup-source;
			wtsr_en = "enabled";
			smpl_en = "enabled";
			wtsr_timer_val = <0x03>;
			smpl_timer_val = <0x00>;
			check_jigon = <0x00>;
			status = "okay";
			samsung,codec-interrupt = <0x0b>;

			regulators {

				BUCK1 {
					regulator-name = "vdd_mif";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x10c8e0>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x02>;
				};

				BUCK2 {
					regulator-name = "vdd_cpucl0";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				BUCK3 {
					regulator-name = "vdd_cpucl1_2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				BUCK4 {
					regulator-name = "vdd_int";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x124f80>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x02>;
				};

				BUCK5 {
					regulator-name = "vdd_g3d";
					phandle = <0x7f01>;
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				BUCK6 {
					regulator-name = "vdd2_mem";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				BUCK7 {
					regulator-name = "vdd_lldo";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x16e360>;
					regulator-always-on;
					regulator-boot-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				BUCK8 {
					regulator-name = "vdd_mldo";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x200b20>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				LDO1 {
					regulator-name = "vdd_ldo1";
					regulator-min-microvolt = <0xaae60>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				LDO2 {
					/* v212: not "vqmmc"/"vmmc": the 5.10 regulator core falls back to a
					 * by-name lookup, so the eMMC host (no supplies in DT) grabbed the
					 * SD card LDOs and its 1.8 V request raced the SD 3.3 V one
					 * ("Restricting voltage", mmc0 error -22, no rootfs, panic). */
					regulator-name = "vqmmc_sd";
					phandle = <0x109>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x337f98>;
					regulator-ramp-delay = <0x2ee0>;
				};

				LDO3 {
					regulator-name = "vdd_ldo3";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1dc130>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				LDO4 {
					regulator-name = "vdd_ldo4";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO5 {
					regulator-name = "vdd_ldo5";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x149970>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO6 {
					regulator-name = "vdd_ldo6";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x149970>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO7 {
					regulator-name = "vdd_ldo7";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1dc130>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO8 {
					regulator-name = "vdd_ldo8";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO9 {
					regulator-name = "vdd_ldo9";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO10 {
					regulator-name = "vdd_ldo10";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO11 {
					regulator-name = "vdd_ldo11";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x13d620>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO12 {
					regulator-name = "vdd_ldo12";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x149970>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO13 {
					regulator-name = "vdd_ldo13";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1dc130>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO14 {
					regulator-name = "vdd_ldo14";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x337f98>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x01>;
				};

				LDO33 {
					regulator-name = "vdd_ldo33";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1dc130>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				LDO34 {
					regulator-name = "vdd_ldo34";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x337f98>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
				};

				LDO35 {
					regulator-name = "vmmc_sd";
					phandle = <0x108>;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x2dc6c0>;
					regulator-ramp-delay = <0x2ee0>;
				};

				LDO36 {
					regulator-name = "vdd_ldo36";
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1dc130>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
					phandle = <0x0c>;
				};

				LDO37 {
					regulator-name = "vdd_ldo37";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x337f98>;
					regulator-always-on;
					regulator-ramp-delay = <0x2ee0>;
					regulator-initial-mode = <0x03>;
					phandle = <0x0d>;
				};
			};
		};

		cod3035x@3 {
			compatible = "codec,cod3035x";
			reg = <0x03>;
			i2c-speedy-address;
			vdd-supply = <0x0c>;
			vdd_ldo36-supply = <0x0c>;
			vdd_ldo37-supply = <0x0d>;
			interrupts-extended = <0x0a 0x00 0x08>;
			pinctrl-names = "default";
			mic-bias1-voltage = <0x01>;
			mic-bias2-voltage = <0x01>;
			mic-bias-ldo-voltage = <0x03>;
			use-lassenA;
			use-btn-adc-mode;
			use-feature-flag = <0x02>;
			use-det-gdet-adc-mode = <0x01>;
			jack-imp-tuning = <0x07>;
			io-channels = <0x0e 0x03 0x0e 0x07>;
			io-channel-names = "adc-ear\0adc-gdet";
			#sound-dai-cells = <0x00>;
			io-channel-ranges;
			but-zones-list = <0x0f 0xe2 0x00 0x178 0x0f 0x246 0x179 0x1bf 0x0f 0x73 0x1c0 0x273 0x0f 0x72 0x274 0x489>;
			mic-adc-range = <0x57c>;
			btn-release-value = <0x57c>;
			phandle = <0x0b>;
		};
	};

	serial@13800000 {
		compatible = "samsung,exynos4210-uart";
		reg = <0x00 0x13800000 0x00 0x100>;
		interrupts = <0x00 0xf6 0x04>;
		clocks = <0x04 0x45 0x04 0x56>;
		clock-names = "uart\0clk_uart_baud0";
		pinctrl-names = "default";
		pinctrl-0 = <0x10>;
		samsung,fifo-size = <0x40>;
		status = "okay";
	};

	hsi2c@13920000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x13920000 0x00 0x1000>;
		interrupts = <0x00 0x10b 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x11>;
		clocks = <0x04 0x3e>;
		clock-names = "hsi2c";
		samsung,usi-i-mode = <0x10032000>;
		status = "okay";
		clock-frequency = <0x61a80>;

		pmic@56 {
			compatible = "samsung,s2mpb03pmic";
			reg = <0x56>;
			disable_ldo2_remote_sense;
			slew2,dram_dsch2 = [01];
			slew2,l5_slew = [00];
			slew2,l6_slew = [00];

			regulators {

				s2mpb03-ldo1 {
					regulator-name = "VDDDF_1.2V_CAM";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
				};

				s2mpb03-ldo2 {
					regulator-name = "VDDDR1_1.05V_CAM";
					regulator-min-microvolt = <0x100590>;
					regulator-max-microvolt = <0x100590>;
				};

				s2mpb03-ldo3 {
					regulator-name = "VDDIOR1_1.8V_CAM";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
				};

				s2mpb03-ldo4 {
					regulator-name = "VDDDR2_1.2V_CAM";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
				};

				s2mpb03-ldo5 {
					regulator-name = "VDDAF_2.8V_CAM";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
				};

				s2mpb03-ldo6 {
					regulator-name = "VDDAR1_2.8V_CAM";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
				};

				s2mpb03-ldo7 {
					regulator-name = "VDDAR2_2.8V_CAM";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
				};
			};
		};
	};

	hsi2c@13930000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x13930000 0x00 0x1000>;
		interrupts = <0x00 0x10c 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x12>;
		clocks = <0x04 0x3e>;
		clock-names = "hsi2c";
		samsung,usi-i-mode = <0x10032000>;
		status = "okay";
		clock-frequency = <0x61a80>;

		touchscreen@48 {
			compatible = "himax,hxcommon";
			reg = <0x48>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x13>;
			himax,irq-gpio = <0x14 0x00 0x00>;
			himax,rst-gpio = <0x15 0x01 0x00>;
			himax,panel-coords = <0x00 0x438 0x00 0x924>;
			himax,display-coords = <0x00 0x438 0x00 0x924>;
			himax,project_name = "M20\0M205F";
			himax,area-size = <0x50 0x7e 0x3c>;
			himax,fw-path = "tsp_himax/hx83112a_m20lte.fw";
			report_type = <0x01>;
			himax,factory_item_version = <0x01>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&m20_key_voldown &m20_key_volup &m20_key_power>;

		button-voldown {
			label = "gpio-keys: KEY_VOLUMEDOWN";
			linux,code = <114>;
			gpios = <&m20_gpa1 6 1>;
		};

		button-volup {
			label = "gpio-keys: KEY_VOLUMEUP";
			linux,code = <115>;
			gpios = <&m20_gpa1 5 1>;
		};

		button-power {
			label = "gpio-keys: KEY_POWER";
			linux,code = <116>;
			gpios = <&m20_gpa1 7 1>;
			wakeup-source;
		};
	};

	reboot {
		compatible = "syscon-reboot";
		regmap = <0x03>;
		offset = <0x400>;
		mask = <0x01>;
		value = <0x01>;
	};

	system-controller@11c80000 {
		compatible = "samsung,exynos7885-pmu", "syscon", "simple-mfd";
		reg = <0x00 0x11c80000 0x00 0x10000>;
		phandle = <0x03>;
		samsung-reboot-flags {
			compatible = "syscon-reboot-mode";
			offset = <0x808>;
			mode-normal = <0x12345678>;

			compatible = "exynos,modem_if";
			reg = <0x00 0xf5400000 0x00 0x8800000>;
			no-map;
			phandle = <0x39>;
		};

		/*
		 * v220: 4.4 reserved these and 5.10 handed them to the page
		 * allocator; firmware/secure world writes there (DRAM test on
		 * MIF-down sleep exit, secure log, TIMA) would hit kernel pages.
		 */
		sec_debug_magic@80000000 {
			reg = <0x00 0x80000000 0x00 0x1000>;
		};

		dram_test@80002000 {
			reg = <0x00 0x80002000 0x00 0x2000>;
		};

		tima@b8000000 {
			reg = <0x00 0xb8000000 0x00 0x200000>;
		};

		seclog@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x80000>;
		};

		/* Bootloader ECT blob (4.4 /ect parameter_address/size). */
		ect@90000000 {
			reg = <0x00 0x90000000 0x00 0x19000>;
			no-map;
		};

		/* 4.4 reserved-memory/gnss_if: GNSS firmware + IPC shared memory. */
		gnss_if@ffc00000 {
			compatible = "exynos,gnss_if";
			reg = <0x00 0xffc00000 0x00 0x400000>;
			no-map;
			phandle = <0x1f2>;
		};

		cp-log@fdc00000 {
			compatible = "exynos,cp_ram_logging";
			reg = <0x00 0xfdc00000 0x00 0x2000000>;
			no-map;
		};

		wifi@e9000000 {
			compatible = "exynos,wifibt_if";
			reg = <0x00 0xe9000000 0x00 0x400000>;
			no-map;
		};

		btabox {
			compatible = "exynos,btabox_rmem";
			size = <0x00 0x400000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x80000000 0x00 0x80000000>;
			no-map;
		};

		framebuffer@ec000000 {
			reg = <0x00 0xec000000 0x00 0x1400000>;
			no-map;
			phandle = <0x1f>;
		};

		ess-log@91200000 {
			reg = <0x00 0x91200000 0x00 0x300000>;
			no-map;
		};

		ess-pstore@91500000 {
			reg = <0x00 0x91500000 0x00 0x8000>;
			no-map;
			phandle = <0x3a>;
		};

		/*
		 * Rest of the 4.4 ESS area (ess_setup=0x91200000 up to
		 * sec_avc_log) plus the Samsung debug areas the bootloader
		 * passes in bootargs: sec_avc_log 0x9240a000, sec_tsp_log
		 * 0x9244c000, sec_summary_log 0x9248e000, sec_debug.base
		 * 0x92790000, auto_summary_log 0x92892000 (+0x10000).  4.4
		 * reserved all of it; bootloader/EL3 write there.
		 */
		samsung-debug@91508000 {
			reg = <0x00 0x91508000 0x00 0x139a000>;
		};

		abox-debug@e9400000 {
			compatible = "exynos,abox_rmem";
			reg = <0x00 0xe9400000 0x00 0x400000>;
			phandle = <0x35>;
		};
	};

	mailbox@12080000 {
		compatible = "samsung,exynos-shd-ipc-mailbox";
		reg = <0x00 0x12080000 0x00 0x180>;
		interrupts = <0x00 0x37 0x04>;
		mcu,name = "mcu_ipc_cp";
		mcu,id = <0x00>;
		status = "okay";
	};

	ect {
		parameter_address = <0x90000000>;
		parameter_size = <0x19000>;
	};

	/* 4.4 usim_det: SIM tray GPIO forwarded to the CP mailbox. */
	usim_det {
		compatible = "samsung,exynos-usim-detect";
		mbx_ap2cp_united_status = <0x02>;
		mif,int_usim0_det_level = <0x04>;
		mif,int_usim1_det_level = <0x05>;
		sbi_usim0_det_mask = <0x01>;
		sbi_usim0_det_pos = <0x12>;
		sbi_usim1_det_mask = <0x01>;
		sbi_usim1_det_pos = <0x13>;
		pinctrl-names = "default";
		pinctrl-0 = <0x1f3>;
		mif,num_of_usim_det = <0x01>;
		mif,usim-det0-gpio = <0x0a 0x06 0x00>;
	};

	/* 4.4 mcu_ipc@120D0000 + gnss_pdata (KEPLER GNSS over shared memory). */
	mailbox@120d0000 {
		compatible = "samsung,exynos-shd-ipc-mailbox";
		reg = <0x00 0x120d0000 0x00 0xb4>;
		interrupts = <0x00 0x38 0x04>;
		mcu,name = "mcu_ipc_gnss";
		mcu,id = <0x01>;
		status = "okay";
		phandle = <0x1f1>;
	};

	gnss_pdata {
		status = "okay";
		compatible = "samsung,gnss_shdmem_if";
		shmem,name = "KEPLER";
		shmem,device_node_name = "gnss_ipc";
		interrupts = <0x00 0x14 0x04 0x00 0xa5 0x04 0x00 0xa4 0x04>;
		interrupt-names = "ACTIVE", "WATCHDOG", "WAKEUP";
		memory-region = <0x1f2>;
		mbox_info = <0x1f1>;
		mbx,int_ap2gnss_bcmd = <0x00>;
		mbx,int_ap2gnss_req_fault_info = <0x01>;
		mbx,int_ap2gnss_ipc_msg = <0x02>;
		mbx,int_ap2gnss_ack_wake_set = <0x03>;
		mbx,int_ap2gnss_ack_wake_clr = <0x04>;
		mbx,irq_gnss2ap_bcmd = <0x00>;
		mbx,irq_gnss2ap_rsp_fault_info = <0x01>;
		mbx,irq_gnss2ap_ipc_msg = <0x02>;
		mbx,irq_gnss2ap_req_wake_clr = <0x04>;
		mbx,reg_bcmd_ctrl = <0x00 0x01 0x02 0x03>;
		reg_rx_ipc_msg = <0x01 0x05>;
		reg_tx_ipc_msg = <0x01 0x04>;
		reg_rx_head = <0x01 0x03>;
		reg_rx_tail = <0x01 0x02>;
		reg_tx_head = <0x01 0x01>;
		reg_tx_tail = <0x01 0x00>;
		fault_info = <0x01 0x200000 0x180000>;
		shmem,ipc_offset = <0x380000>;
		shmem,ipc_size = <0x80000>;
		shmem,ipc_reg_cnt = <0x20>;
		shmem,boot_without_mbox = <0x01>;
	};

	modem@10000 {
		reg = <0x00 0x10000 0x00 0x00>;
		compatible = "sec_modem,modem_pdata";
		status = "okay";
		interrupts = <0x00 0x13 0x04 0x00 0xd9 0x04>;
		gpios = <0x37 0x07 0x00 0x38 0x00 0x00 0x38 0x01 0x00>;
		mif,name = "s327ap";
		mif,modem_net = <0x00>;
		mif,modem_type = <0x0a>;
		mif,use_handover = <0x00>;
		mif,ipc_version = <0x32>;
		mif,link_types = <0x200>;
		mif,link_name = "shmem";
		mif,link_attrs = <0x7c9>;
		mif,num_iodevs = <0x17>;
		mbx_ap2cp_msg = <0x00>;
		mbx_cp2ap_msg = <0x01>;
		mbx_ap2cp_united_status = <0x02>;
		mbx_cp2ap_united_status = <0x03>;
		mbx_ap2cp_mif_value = <0x04>;
		mbx_ap2cp_kerneltime = <0x09>;
		mif,int_ap2cp_msg = <0x00>;
		mif,int_ap2cp_wakeup = <0x01>;

	cp-shmem {
		status = "okay";
		memory-region = <0x39>;
		compatible = "samsung,exynos-shm_ipc";
		shmem,cp_size = <0x7900000>;
		shmem,vss_size = <0x700000>;
		shmem,ipc_offset = <0x8000000>;
		shmem,ipc_size = <0x800000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		linux,initrd-start = <0x84000000>;
		linux,initrd-end = <0x840fffff>;
		bootargs = "console=tty0 console=ttySAC0,115200 earlycon=esslog,0x91500000 keep_bootcon clk_ignore_unused regulator_ignore_unused pd_ignore_unused androidboot.hardware=samsungexynos7885 androidboot.selinux=permissive panic=5 rdinit=/yok ignore_loglevel";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x3da00000>;
	};

	memory@c0000000 {
		device_type = "memory";
		reg = <0x00 0xc0000000 0x00 0x40000000>;
	};

	/* placeholders the Samsung bootloader fills with the RAM above 4 GiB (as in 4.4) */
	memory@880000000 {
		device_type = "memory";
		reg = <0x08 0x80000000 0x00 0x00>;
	};

	memory@900000000 {
		device_type = "memory";
		reg = <0x09 0x00000000 0x00 0x00>;
	};

	ramoops {
		compatible = "ramoops";
		status = "disabled";
		memory-region = <0x3a>;
		record-size = <0x00>;
		console-size = <0x4000>;
		pmsg-size = <0x4000>;
		ftrace-size = <0x00>;
		dump-oops;
	};

	framebuffer@ec000000 {
		compatible = "simple-framebuffer";
		reg = <0x00 0xec000000 0x00 0x1400000>;
		width = <0x438>;
		height = <0x924>;
		stride = <0x10e0>;
		format = "a8b8g8r8";
		status = "okay";
	};

	muic {
		new_factory;
		dcd_timeout;
	};

	pdic-manager {
		pdic,max_power = <0x1388>;
		pdic,op_power = <0x9c4>;
		pdic,max_voltage = <0x1770>;
		pdic,max_current = <0x7d0>;
		pdic,min_current = <0x1f4>;
		pdic,giveback = <0x00>;
		pdic,usb_com_capable = <0x01>;
		pdic,no_usb_suspend = <0x01>;
		source,max_voltage = <0x1388>;
		source,min_voltage = <0xfa0>;
		source,max_power = <0x9c4>;
		sink,capable_max_voltage = <0x2328>;
	};

	usb_notifier {
		compatible = "samsung,usb-notifier";
		udc = <0x26>;
	};

	decon_board_hx83112a {
		gpio_lcd_1p8 = <0x3b 0x02 0x00>;
		gpio_blic_on = <0x3b 0x00 0x00>;
		gpio_panel_enp = <0x15 0x03 0x00>;
		gpio_panel_enn = <0x15 0x06 0x00>;
		gpio_lcd_rst = <0x15 0x00 0x00>;
		gpio_tsp_rst = <0x15 0x01 0x00>;
		phandle = <0x3c>;

		dsim_set_panel_power_early {
			type = "gpio,high\0gpio_lcd_1p8\0delay,usleep", "5000\0gpio,high\0gpio_blic_on\0delay,usleep", "5000";
		};

		dsim_set_panel_power_enable {
			type = "delay,usleep", "1000\0gpio,high\0gpio_panel_enp\0delay,usleep", "2000\0gpio,high\0gpio_panel_enn\0delay,usleep", "5000";
		};

		dsim_set_panel_power_disable {
			type = "gpio,low\0gpio_tsp_rst\0gpio,low\0gpio_lcd_rst\0delay,usleep", "5000\0gpio,low\0gpio_panel_enn\0delay,usleep", "5000\0gpio,low\0gpio_panel_enp\0delay,usleep", "5000\0gpio,low\0gpio_blic_on\0delay,usleep", "5000\0gpio,low\0gpio_lcd_1p8";
		};

		dsim_reset_panel {
			type = "gpio,high\0gpio_tsp_rst\0gpio,high\0gpio_lcd_rst\0delay,usleep", "1000\0gpio,low\0gpio_lcd_rst\0delay,usleep", "1000\0gpio,high\0gpio_lcd_rst\0delay,msleep", "30";
		};
	};

	hx83112a {
		mode = <0x00>;
		resolution = <0x438 0x924>;
		size = <0x43 0x91>;
		timing,refresh = <0x3c>;
		timing,h-porch = <0x08 0x1c 0x08>;
		timing,v-porch = <0x05 0x1b 0x05>;
		timing,dsi-hs-clk = <0x44c>;
		timing,pms = <0x03 0x7f 0x00>;
		timing,dsi-escape-clk = <0x10>;
		mic_en = <0x00>;
		mic_ratio = <0x00>;
		mic_ver = <0x00>;
		type_of_ddi = <0x00>;
		dsc_en = <0x00>;
		dsc_cnt = <0x00>;
		dsc_slice_num = <0x00>;
		data_lane = <0x04>;
		vt_compensation = <0x324>;
		eotp_disabled = <0x01>;
		decon_board = <0x3c>;
		phandle = <0x21>;
	};

	hs_tune {
		hs_tune_cnt = <0x0c>;
		phandle = <0x27>;

		hs_tune1 {
			tune_name = "tx_vref";
			tune_value = <0x0d 0x0a>;
		};

		hs_tune2 {
			tune_name = "tx_pre_emp";
			tune_value = <0x03 0x03>;
		};

		hs_tune3 {
			tune_name = "tx_pre_emp_plus";
			tune_value = <0x00 0x00>;
		};

		hs_tune4 {
			tune_name = "tx_res";
			tune_value = <0x03 0x03>;
		};

		hs_tune5 {
			tune_name = "tx_rise";
			tune_value = <0x03 0x03>;
		};

		hs_tune6 {
			tune_name = "tx_hsxv";
			tune_value = <0x03 0x03>;
		};

		hs_tune7 {
			tune_name = "tx_fsls";
			tune_value = <0x03 0x03>;
		};

		hs_tune8 {
			tune_name = "rx_sqrx";
			tune_value = <0x07 0x07>;
		};

		hs_tune9 {
			tune_name = "compdis";
			tune_value = <0x07 0x07>;
		};

		hs_tune10 {
			tune_name = "otg";
			tune_value = <0x02 0x02>;
		};

		hs_tune11 {
			tune_name = "enable_user_imp";
			tune_value = <0x00 0x00>;
		};

		hs_tune12 {
			tune_name = "is_phyclock";
			tune_value = <0x01 0x01>;
		};
	};

	but-zones {
		#list-but-cells = <0x03>;
		phandle = <0x0f>;
	};

	audio-codec-dummy {
		compatible = "snd-soc-dummy";
		#sound-dai-cells = <0x00>;
		phandle = <0x3d>;
	};

	sound {
		status = "okay";
		compatible = "samsung,exynos7885-cod3035";
		mic-bias-mode = <0x01 0x01 0x02 0x00>;
		samsung,codec = <0x34>;
		samsung,routing = "VOUTPUT\0ABOX UAIF0 Playback\0VOUTPUTCALL\0ABOX UAIF2 Playback\0ABOX UAIF2 Capture\0VINPUTCALL\0ABOX SPEEDY Capture\0VINPUTFM\0SPK\0AIF Playback-b-34\0AIF Playback-b-34\0ABOX UAIF3 Playback\0ABOX UAIF3 Capture\0AIF Capture-b-34";

		rdma-0 {

			cpu {
				sound-dai = <0x34 0x00>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-1 {

			cpu {
				sound-dai = <0x34 0x01>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-2 {

			cpu {
				sound-dai = <0x34 0x02>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-3 {

			cpu {
				sound-dai = <0x34 0x03>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-4 {

			cpu {
				sound-dai = <0x34 0x04>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-5 {

			cpu {
				sound-dai = <0x34 0x05>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-6 {

			cpu {
				sound-dai = <0x34 0x06>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		rdma-7 {

			cpu {
				sound-dai = <0x34 0x07>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		wdma-0 {

			cpu {
				sound-dai = <0x34 0x08>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		wdma-1 {

			cpu {
				sound-dai = <0x34 0x09>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		wdma-2 {

			cpu {
				sound-dai = <0x34 0x0a>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		wdma-3 {

			cpu {
				sound-dai = <0x34 0x0b>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		wdma-4 {

			cpu {
				sound-dai = <0x34 0x0c>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		uaif-0 {

			cpu {
				sound-dai = <0x34 0x0d>;
			};

			codec {
				sound-dai = <0x0b>;
			};
		};

		uaif-1 {

			cpu {
				sound-dai = <0x34 0x0e>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		uaif-2 {

			cpu {
				sound-dai = <0x34 0x0f>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		uaif-3 {

			cpu {
				sound-dai = <0x34 0x10>;
			};

			codec {
				sound-dai = <0x3e 0x00>;
			};
		};

		internal-0 {

			cpu {
				sound-dai = <0x34 0x11>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};

		speedy-0 {

			cpu {
				sound-dai = <0x34 0x12>;
			};

			codec {
				sound-dai = <0x3d>;
			};
		};
	};
};

/ {
	mmc-srpmb {
		compatible = "samsung,mmc-srpmb";
		interrupts = <0x00 0xde 0x01>;
	};
};

/ {
	clock-controller@11400000 {
		compatible = "samsung,exynos7885-cmu-g3d";
		reg = <0x00 0x11400000 0x00 0x8000>;
		#clock-cells = <0x01>;
		clocks = <0x04 0x01>, <0x04 0x15f>;
		clock-names = "osc", "switch";
		power-domains = <0x7f00>;
		phandle = <0x7f02>;
	};

	mali@11500000 {
		compatible = "samsung,exynos7904-mali", "arm,mali";
		clocks = <0x7f02 0x140>, <0x7f02 0x155>, <0x7f02 0x156>,
			 <0x7f02 0x157>, <0x04 0x01>, <0x7f02 0x159>,
			 <0x7f02 0x15e>, <0x7f02 0x15a>, <0x7f02 0x15b>,
			 <0x7f02 0x15c>, <0x7f02 0x15d>;
		clock-names = "g3d", "pll", "busd", "switch", "osc", "cmu",
			      "sysreg", "lhm-sfr", "lhm-p", "lhs-d", "lhs-sfr";
		reg = <0x00 0x11500000 0x00 0x5000>;
		interrupts = <0x00 0x9f 0x04>, <0x00 0xa0 0x04>, <0x00 0x9e 0x04>;
		interrupt-names = "JOB", "MMU", "GPU";
		power-domains = <0x7f00>;
		g3d_cmu_cal_id = <0x0b040004>;
		g3d_genpd_name = "pd-g3d";
		#cooling-cells = <0x02>;
		governor = "interactive";
		gpu_sustainable_info = <0 0 0 0 0>;
		gpu_pmqos_cpu_cluster_num = <2>;
		gpu_pmu_status_reg_offset = <0x40A4>;
		gpu_pmu_status_local_pwr_mask = <0xF>;
		gpu_min_clock = <343000>;
		gpu_dvfs_start_clock = <343000>;
		gpu_dvfs_bl_config_clock = <343000>;
		gpu_default_voltage = <800000>;
		gpu_cold_minimum_vol = <0>;
		gpu_voltage_offset_margin = <37500>;
		gpu_tmu_control = <1>;
		gpu_power_coeff = <625>;
		gpu_dvfs_time_interval = <5>;
		gpu_default_wakeup_lock = <1>;
		gpu_dynamic_abb = <0>;
		gpu_early_clk_gating = <0>;
		gpu_dvs = <0>;
		gpu_inter_frame_pm = <0>;
		gpu_perf_gathering = <0>;
		gpu_runtime_pm_delay_time = <50>;
		gpu_dvfs_polling_time = <30>;
		gpu_pmqos_int_disable = <0>;
		gpu_pmqos_mif_max_clock = <1794000>;
		gpu_pmqos_mif_max_clock_base = <545000>;
		gpu_cl_dvfs_start_base = <343000>;
		gpu_debug_level = <3>;
		gpu_trace_level = <8>;
		gpu_mo_min_clock = <676000>;
		gpu_boost_gpu_min_lock = <0>;
		gpu_boost_egl_min_lock = <1248000>;
		gpu_bts_support = <0>;
		gpu_asv_cali_lock_val = <0>;
		gpu_set_pmu_duration_reg = <0>;
		gpu_set_pmu_duration_val = <0>;
	};
};

/ {
	m20lte-vibrator {
		compatible = "samsung,m20lte-vibrator";
		enable-gpios = <0x7f03 0x03 0x00>;
	};
};

/ {
	tmu@10070000 {
		compatible = "samsung,exynos7904-tmu";
		reg = <0x00 0x10070000 0x00 0x400>,
		      <0x00 0x10074000 0x00 0x400>;
		reg-names = "cpu", "gpu";
	};
};

/ {
	acpm_dvfs {
		compatible = "samsung,exynos-acpm-dvfs";
		/* Command channel from the stock clock-controller node.
		 * Channel 5 belongs to unsolicited MIF notifications.
		 */
		acpm-ipc-channel = <0>;
		fvp-channel {
			acpm-ipc-channel = <1>;
		};
	};
};

/* Real vendor display path, equivalent to exynos7904-m20lte-decon.dts.
 * Keep all on-device bring-up fixes above; do not replace the base DT.
 */
&{/framebuffer@ec000000} {
	status = "disabled";
};
&{/reserved-memory/framebuffer@ec000000} {
	/delete-property/ no-map;
	compatible = "exynos,dpu_fb_handover";
};
&{/sysmmu@148c0000} {
	status = "okay";
	interrupts = <0 128 4>, <0 127 4>;
};
&{/dpp@148b1000} {
	status = "okay";
	interrupts = <0 121 4>;
};
&{/dpp@148b2000} {
	status = "okay";
	interrupts = <0 122 4>;
};
&{/dpp@148b3000} {
	status = "okay";
	interrupts = <0 123 4>;
};
&{/dpp@148b4000} {
	status = "okay";
	interrupts = <0 124 4>, <0 120 4>;
};
&{/dsim@14870000} {
	status = "okay";
	interrupts = <0 125 4>;
};
&{/decon_f@14860000} {
	status = "okay";
	interrupts = <0 115 4>, <0 114 4>, <0 113 4>, <0 112 4>;
};
&{/i2c@13870000} {
	status = "okay";
	interrupts = <0 252 4>;
};

/* ET520 wiring from the standalone fingerprint DT and vendor M20 overlay. */
&{/pinctrl@11CB0000} {
	sim0_det_gpio: sim0-det-gpio {
		samsung,pins = "gpa2-6";
		samsung,pin-function = <0x0f>;
		samsung,pin-pud = <0x00>;
		phandle = <0x1f3>;
	};

	fp_irq: fp-irq {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <15>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <3>;
	};
	fp_irq_sleep: fp-irq-sleep {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <3>;
	};
};

&{/pinctrl@139b0000} {
	fp_reset: fp-reset {
		samsung,pins = "gpg3-2";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <3>;
	};
	fp_ldo: fp-ldo {
		samsung,pins = "gpg3-3";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	fp_spi_inactive: fp-spi-inactive {
		samsung,pins = "gpp6-0", "gpp6-1", "gpp6-2", "gpp6-3";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <2>;
	};
	fp_spi_clk: fp-spi-clk {
		samsung,pins = "gpp6-0";
		samsung,pin-function = <2>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <2>;
	};
	fp_spi_cs: fp-spi-cs {
		samsung,pins = "gpp6-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <2>;
	};
	fp_spi_miso: fp-spi-miso {
		samsung,pins = "gpp6-2";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <2>;
	};
	fp_spi_mosi: fp-spi-mosi {
		samsung,pins = "gpp6-3";
		samsung,pin-function = <2>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <2>;
	};
};

/ {
	aliases {
		spi1 = &spi_1;
	};

	spi_1: spi@13910000 {
		secure-mode;
		compatible = "samsung,exynos7885-spi";
		reg = <0 0x13910000 0 0x100>;
		interrupts = <0 256 4>;
		clocks = <0x04 61>, <0x04 93>;
		clock-names = "spi", "spi_busclk0";
		#address-cells = <1>;
		#size-cells = <0>;
		num-cs = <1>;
		status = "okay";
		fingerprint@0 {
			compatible = "etspi,et5xx";
			reg = <0>;
			spi-max-frequency = <16000000>;
			pinctrl-names = "default", "pins_poweron", "pins_poweroff", "pins_poweron_tz", "pins_poweroff_tz";
			pinctrl-0 = <&fp_irq_sleep &fp_reset &fp_ldo>;
			pinctrl-1 = <&fp_irq &fp_spi_clk &fp_spi_cs &fp_spi_miso &fp_spi_mosi>;
			pinctrl-2 = <&fp_irq_sleep &fp_spi_inactive>;
			pinctrl-3 = <&fp_irq>;
			pinctrl-4 = <&fp_irq_sleep>;
			etspi-sleepPin = <0x37 2 0>;
			etspi-drdyPin = <0x14 5 0>;
			etspi-ldoPin = <0x37 3 0>;
			etspi-chipid = "ET520";
			etspi-orient = <1>;
			controller-data {
				samsung,spi-feedback-delay = <0>;
			};
		};
	};
};

/* M20 physical sensors, using the existing v108 kernel drivers.
 * Reserve low unused phandles to preserve the existing fingerprint handles.
 */
&{/pinctrl@11CB0000} {
	m20_sensor_prox_irq: m20-sensor-prox-irq {
		phandle = <0x100>;
		samsung,pins = "gpa0-4";
		samsung,pin-function = <15>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	m20_sensor_grip_irq: m20-sensor-grip-irq {
		phandle = <0x101>;
		samsung,pins = "gpa2-7";
		samsung,pin-function = <15>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	m20_sensor_grip_input: m20-sensor-grip-input {
		phandle = <0x102>;
		samsung,pins = "gpa2-7";
		samsung,pin-function = <0>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&{/pinctrl@139b0000/gpp7} {
	phandle = <0x105>;
};

&{/pinctrl@139b0000} {
	/* i2c-gpio owns the bus: do not mux it to a hardware I2C block. */
	m20_sensor_grip_bus: m20-sensor-grip-bus {
		phandle = <0x103>;
		samsung,pins = "gpp7-0", "gpp7-1";
		samsung,pin-function = <0>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
	m20_sensor_grip_idle: m20-sensor-grip-idle {
		phandle = <0x104>;
		samsung,pins = "gpp7-0", "gpp7-1";
		samsung,pin-function = <0>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&{/i2c@13880000} {
	status = "okay";
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	gp2a@39 {
		compatible = "sharp,gp2ap110s";
		reg = <0x39>;
		pinctrl-names = "default";
		pinctrl-0 = <&m20_sensor_prox_irq>;
		interrupt-parent = <0x14>;
		interrupts = <4 0>;
		gp2ap110s,led_reg_val_1 = <0x14>;
		gp2ap110s,ps_high_th_1 = <370>;
		gp2ap110s,ps_low_th_1 = <260>;
		gp2ap110s,led_reg_val_2 = <0x24>;
		gp2ap110s,ps_high_th_2 = <200>;
		gp2ap110s,ps_low_th_2 = <170>;
		gp2ap110s,settings_thd_low = <130>;
		gp2ap110s,settings_thd_high = <370>;
		gp2ap110s,gpio_int = <0x14 4 0>;
	};
};

&{/i2c@13890000} {
	status = "okay";
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	lsm6dsl@6b {
		compatible = "st,lsm6dsl";
		reg = <0x6b>;
		interrupt-parent = <0x14>;
		interrupts = <3 0>;
		st,irq_gpio = <0x14 3 0>;
		st,orientation = <1 0 1 2 1 1 1 1 2>;
	};

	yas539@2e {
		compatible = "yas_magnetometer";
		reg = <0x2e>;
		yas,orientation = <6>;
		yas,softiron = <9270 310 480 310 10280 90 480 90 10450>;
		yas,softiron_sign = <2 2 2 2 2 0 2 0 2>;
	};
};

/ {
	aliases {
		/* Do not raise the dynamic-bus floor or renumber audio/PMIC I2C. */
		i2c2 = "/i2c@20";
		i2c5 = "/i2c@13880000";
		i2c6 = "/i2c@13890000";
	};

	i2c@20 {
		compatible = "i2c-gpio";
		sda-gpios = <0x105 0 0>;
		scl-gpios = <0x105 1 0>;
		i2c-gpio,delay-us = <5>;
		pinctrl-names = "default", "on_i2c", "off_i2c";
		pinctrl-0 = <&m20_sensor_grip_bus>;
		pinctrl-1 = <&m20_sensor_grip_bus>;
		pinctrl-2 = <&m20_sensor_grip_idle>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		tc3xxk@20 {
			compatible = "coreriver,tc3xx-grip";
			pinctrl-names = "default", "on_irq", "off_irq";
			pinctrl-0 = <&m20_sensor_grip_irq>;
			pinctrl-1 = <&m20_sensor_grip_irq>;
			pinctrl-2 = <&m20_sensor_grip_input>;
			reg = <0x20>;
			interrupt-parent = <0x0a>;
			interrupts = <7 0>;
			coreriver,scl-gpio = <0x105 1 0>;
			coreriver,sda-gpio = <0x105 0 0>;
			coreriver,irq-gpio = <0x0a 7 0>;
			coreriver,ldo_en = <0x3b 6 0>;
			coreriver,i2c-gpio;
			coreriver,boot-on-ldo;
			/* Keep the installed firmware; do not auto-flash the chip. */
			coreriver,bringup;
			coreriver,fw_name = "coreriver/tc305k_m20_grip.fw";
			coreriver,use_bitmap = <1>;
		};
	};
};

/* Cluster1 watchdog from the 4.4 exynos7885.dtsi. */
/ {
	watchdog@10060000 {
		compatible = "samsung,exynos8-wdt";
		reg = <0x00 0x10060000 0x00 0x100>;
		interrupts = <0 233 4>;
		clocks = <0x04 0x4c>;
		clock-names = "watchdog";
		timeout-sec = <30>;
		samsung,syscon-phandle = <0x03>;
	};
};

/* microSD slot (dwmmc2) from the 4.4 M20 tree; SD high-speed only, no UHS. */
&{/pinctrl@11CB0000} {
	m20_sd_cd: m20-sd-cd {
		samsung,pins = "gpa0-7";
		samsung,pin-function = <15>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <3>;
	};
};

&{/pinctrl@13430000} {
	m20_sd2_clk: m20-sd2-clk {
		phandle = <0x10a>;
		samsung,pins = "gpf4-0";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <2>;
	};
	m20_sd2_cmd: m20-sd2-cmd {
		phandle = <0x10b>;
		samsung,pins = "gpf4-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <2>;
	};
	m20_sd2_bus1: m20-sd2-bus1 {
		phandle = <0x10c>;
		samsung,pins = "gpf4-2";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <2>;
	};
	m20_sd2_bus4: m20-sd2-bus4 {
		phandle = <0x10d>;
		samsung,pins = "gpf4-3", "gpf4-4", "gpf4-5";
		samsung,pin-function = <2>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <2>;
	};
};

/ {
	dwmmc2@13550000 {
		compatible = "samsung,exynos-dw-mshc";
		reg = <0x00 0x13550000 0x00 0x2000>;
		interrupts = <0 147 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <0x04 0xfa 0x04 0x107>;
		clock-names = "biu", "ciu";
		mmc-exynos-smu = <0x05>;
		status = "okay";
		bus-width = <4>;
		cap-sd-highspeed;
		sd-uhs-sdr50;
		sd-uhs-sdr104;
		max-frequency = <200000000>;
		cd-gpios = <0x14 7 1>;
		disable-wp;
		vmmc-supply = <0x108>;
		vqmmc-supply = <0x109>;
		fifo-depth = <0x40>;
		card-detect-delay = <200>;
		samsung,dw-mshc-ciu-div = <3>;
		samsung,dw-mshc-sdr-timing = <3 0 2 0>;
		samsung,dw-mshc-ddr-timing = <3 0 2 1>;
		samsung,dw-mshc-sdr50-timing = <3 0 4 2>;
		samsung,dw-mshc-sdr104-timing = <3 0 3 0>;
		pinctrl-names = "default";
		pinctrl-0 = <0x10a 0x10b 0x10c 0x10d>;
	};
};

/* Board GPIO init from the 4.4 M20 tree (swa_open_gpio_02 initial3): sensor
 * load switches. Without these the sensors are unpowered and clamp SDA/SCL low.
 */
&{/pinctrl@139b0000/gpp8} {
	sensor-ldo-en {
		gpio-hog;
		gpios = <1 0>;
		output-high;
		line-name = "SENSOR_LDO_EN";
	};
};

&{/pinctrl@139b0000/gpg3} {
	sensor-ldo-1p8-en {
		gpio-hog;
		gpios = <1 0>;
		output-high;
		line-name = "SENSOR_LDO_1P8_EN";
	};
};

/* Camera/ISP power domains and their CMUs (clock gates for FIMC-IS). */
/ {
	power-domain@11c84080 {
		compatible = "samsung,exynos7885-cam-pd";
		reg = <0x00 0x11c84080 0x00 0x20>;
		#power-domain-cells = <0x00>;
		samsung,pmu = <0x03>;
		status = "okay";
		phandle = <0x7f10>;
	};

	power-domain@11c84060 {
		compatible = "samsung,exynos7885-isp-pd";
		reg = <0x00 0x11c84060 0x00 0x20>;
		#power-domain-cells = <0x00>;
		samsung,pmu = <0x03>;
		status = "okay";
		phandle = <0x7f11>;
	};

	clock-controller@14500000 {
		compatible = "samsung,exynos7885-cmu-cam";
		reg = <0x00 0x14500000 0x00 0x8000>;
		#clock-cells = <0x01>;
		power-domains = <0x7f10>;
		phandle = <0x7f12>;
	};

	clock-controller@14700000 {
		compatible = "samsung,exynos7885-cmu-isp";
		reg = <0x00 0x14700000 0x00 0x8000>;
		#clock-cells = <0x01>;
		power-domains = <0x7f11>;
		phandle = <0x7f13>;
	};
};

/* Camera: SYSMMUs and the FIMC-IS core, from the 4.4 exynos7885.dtsi. */
/ {
	sysmmu@14540000 {
		compatible = "samsung,exynos7885-sysmmu";
		reg = <0x00 0x14540000 0x00 0x9000>;
		interrupts = <0 307 4>, <0 308 4>;
		qos = <15>;
		clock-names = "aclk";
		clocks = <0x7f12 0xb1>;
		power-domains = <0x7f10>;
		port-name = "CAM (CSIS, TAA)";
		#iommu-cells = <0>;
		status = "okay";
		phandle = <0x7f20>;
	};

	sysmmu@14730000 {
		compatible = "samsung,exynos7885-sysmmu";
		reg = <0x00 0x14730000 0x00 0x9000>;
		interrupts = <0 317 4>, <0 318 4>;
		qos = <15>;
		clock-names = "aclk";
		clocks = <0x7f13 0x9a>;
		power-domains = <0x7f11>;
		port-name = "ISP, VRA, GDC";
		#iommu-cells = <0>;
		status = "okay";
		phandle = <0x7f21>;
	};

	sysmmu@14760000 {
		compatible = "samsung,exynos7885-sysmmu";
		reg = <0x00 0x14760000 0x00 0x9000>;
		interrupts = <0 321 4>, <0 322 4>;
		qos = <15>;
		clock-names = "aclk";
		clocks = <0x7f13 0x9b>;
		power-domains = <0x7f11>;
		port-name = "MC-SCALER";
		#iommu-cells = <0>;
		status = "okay";
		phandle = <0x7f22>;
	};

	fimc_is@14450000 {
		compatible = "samsung,exynos5-fimc-is";
		reg = <0x00 0x14440000 0x00 0x10000>,
		      <0x00 0x14450000 0x00 0x10000>,
		      <0x00 0x14460000 0x00 0x10000>,
		      <0x00 0x14600000 0x00 0x10000>,
		      <0x00 0x14640000 0x00 0x10000>,
		      <0x00 0x14610000 0x00 0x10000>,
		      <0x00 0x14620000 0x00 0x10000>;
		interrupts = <0 301 4>, <0 302 4>, <0 303 4>, <0 304 4>,
			     <0 310 4>, <0 311 4>, <0 314 4>, <0 312 4>;
		power-domains = <0x7f10>;
		clocks = <0x7f13 0x96>, <0x7f13 0x97>, <0x7f13 0x98>, <0x7f13 0x99>,
			 <0x7f13 0x9a>, <0x7f13 0x9b>,
			 <0x7f12 0xaa>, <0x7f12 0xab>, <0x7f12 0xac>, <0x7f12 0xad>,
			 <0x7f12 0xae>, <0x7f12 0xaf>, <0x7f12 0xb0>, <0x7f12 0xb1>,
			 <0x04 0x67>, <0x04 0x68>, <0x04 0x69>;
		clock-names = "GATE_IS_ISP", "GATE_IS_MCSC", "GATE_IS_VRA", "GATE_IS_GDC",
			"GATE_SMMU_IS0", "GATE_SMMU_IS1",
			"GATE_CAM_3AA1", "GATE_CAM_3AA0", "GATE_CAM_CSIS_DMA",
			"GATE_CAM_CSIS0", "GATE_CAM_CSIS1", "GATE_CAM_CSIS2",
			"GATE_CAM_CSIS3", "GATE_CAM_SMMU",
			"CIS_CLK0", "CIS_CLK1", "CIS_CLK2";
		/* The three camera blocks share the FIMC-IS DMA page table. */
		iommus = <0x7f21>, <0x7f22>, <0x7f20>;
		status = "okay";
	};
};

/* Dedicated reusable CMA for the camera ISP buffers (below 4 GiB for 32-bit DMA). */
&{/reserved-memory} {
	fimc_is_cma: fimc-is-cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x00 0x04000000>;
		alignment = <0x00 0x00400000>;
		alloc-ranges = <0x00 0x80000000 0x00 0x80000000>;
		phandle = <0x7f30>;
	};
};

&{/fimc_is@14450000} {
	memory-region = <0x7f30>;
	pinctrl-names = "default", "release";
	pinctrl-0 = <0x7f46 0x7f49 0x7f4b>;
	pinctrl-1 = <>;
	sensor_common_cfg {
		use_csi_dma_split;
	};

	vender {
		rear_sensor_id = <59>; /* SENSOR_NAME_S5K3L6 */
		front_sensor_id = <39>;		/* SENSOR_NAME_S5K4HA */
		rear3_sensor_id = <41>;	/* SENSOR_NAME_S5K5E9 */

		need_i2c_config;
		//use_module_check;
		check_sensor_vendor;
		//skip_cal_loading;
		max_supported_camera = <3>;
		supported_cameraId = <0 1 52>;

		max_camera_num = <4>;
		camera_info0 {				/* 0 : rear - board camera */
			isp = <0>;				/* 0 : INT , 1 : EXT , 2 : SOC */
			cal_memory = <2>;			/* 0 : N , 1 : FROM , 2 : EEPROM , 3 : OTP  */
			read_version = <0>;		/* 0 : SYSFS , 1 : CAMON */
			core_voltage = <0>;		/* 0 : N , 1 : Y  */
			upgrade = <0>;			/* 0 : N , 1 : SYSFS , 2 : CAMON */
			companion = <0>;			/* 0 : N , 1 : Y  */
			ois = <0>;				/* 0 : N , 1 : Y  */
			valid = <1>;				/* 0 : INVALID, 1 : VALID */
			dual_open = <0>;			/* 0 : SINGLE_OPEN , 1 : DUAL_OPEN */
			position = <0>;			/* 0 : Rear, 1:Front, 2:Rear2, 5:Front2, 6:Rear3 */
		};
		camera_info1 {				/* 1 : front1 - board camera */
			isp = <0>;				/* 0 : INT , 1 : EXT , 2 : SOC */
			cal_memory = <2>;			/* 0 : N , 1 : FROM , 2 : EEPROM , 3 : OTP  */
			read_version = <0>;		/* 0 : SYSFS , 1 : CAMON */
			core_voltage = <0>;		/* 0 : N , 1 : Y  */
			upgrade = <0>;			/* 0 : N , 1 : SYSFS , 2 : CAMON */
			companion = <0>;			/* 0 : N , 1 : Y  */
			ois = <0>;				/* 0 : N , 1 : Y  */
			valid = <1>;				/* 0 : INVALID, 1 : VALID */
			dual_open = <0>;			/* 0 : SINGLE_OPEN , 1 : DUAL_OPEN */
			position = <1>;			/* 0 : Rear, 1:Front, 2:Rear2, 5:Front2, 6:Rear3 */
		};
		camera_info3 {				/* 1 : rear3 - SENSOR_NAME_S5K5E9 */
			isp = <0>;				/* 0 : INT , 1 : EXT , 2 : SOC */
			cal_memory = <2>;			/* 0 : N , 1 : FROM , 2 : EEPROM , 3 : OTP  */
			read_version = <0>;		/* 0 : SYSFS , 1 : CAMON */
			core_voltage = <0>;		/* 0 : N , 1 : Y  */
			upgrade = <0>;			/* 0 : N , 1 : SYSFS , 2 : CAMON */
			companion = <0>;			/* 0 : N , 1 : Y  */
			ois = <0>;				/* 0 : N , 1 : Y  */
			valid = <1>;				/* 0 : INVALID, 1 : VALID */
			dual_open = <0>;			/* 0 : SINGLE_OPEN , 1 : DUAL_OPEN */
			position = <6>;			/* 0 : Rear, 1:Front, 2:Rear2, 5:Front2, 6:Rear3 */
		};

	};
};

/* Camera sensors, I2C buses, MCLK pins and MIPI PHYs, from the 4.4 M20 tree. */
&{/pinctrl@139b0000/gpg0} { phandle = <0x7f40>; };
&{/pinctrl@139b0000/gpc1} { phandle = <0x7f41>; };

&{/pinctrl@139b0000} {
	cam_hs_i2c0_bus: cam-hs-i2c0-bus {
		phandle = <0x7f42>;
		samsung,pins = "gpc1-1", "gpc1-0";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <3>;
	};
	cam_hs_i2c1_bus: cam-hs-i2c1-bus {
		phandle = <0x7f43>;
		samsung,pins = "gpc1-3", "gpc1-2";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <3>;
	};
	cam_hs_i2c2_bus: cam-hs-i2c2-bus {
		phandle = <0x7f44>;
		samsung,pins = "gpc1-5", "gpc1-4";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <3>;
	};
	cam_hs_i2c3_bus: cam-hs-i2c3-bus {
		phandle = <0x7f45>;
		samsung,pins = "gpc1-7", "gpc1-6";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <3>;
	};
	cam_mclk0_out: cam-mclk0-out { phandle = <0x7f46>; samsung,pins = "gpc0-0"; samsung,pin-function = <1>; samsung,pin-pud = <0>; samsung,pin-drv = <2>; };
	cam_mclk0_in: cam-mclk0-in { phandle = <0x7f47>; samsung,pins = "gpc0-0"; samsung,pin-function = <0>; samsung,pin-pud = <0>; samsung,pin-drv = <2>; };
	cam_mclk0_fn: cam-mclk0-fn { phandle = <0x7f48>; samsung,pins = "gpc0-0"; samsung,pin-function = <2>; samsung,pin-pud = <0>; samsung,pin-drv = <2>; };
	cam_mclk1_out: cam-mclk1-out { phandle = <0x7f49>; samsung,pins = "gpc0-1"; samsung,pin-function = <1>; samsung,pin-pud = <0>; samsung,pin-drv = <1>; };
	cam_mclk1_fn: cam-mclk1-fn { phandle = <0x7f4a>; samsung,pins = "gpc0-1"; samsung,pin-function = <2>; samsung,pin-pud = <0>; samsung,pin-drv = <1>; };
	cam_mclk2_out: cam-mclk2-out { phandle = <0x7f4b>; samsung,pins = "gpc0-2"; samsung,pin-function = <1>; samsung,pin-pud = <0>; samsung,pin-drv = <1>; };
	cam_mclk2_fn: cam-mclk2-fn { phandle = <0x7f4c>; samsung,pins = "gpc0-2"; samsung,pin-function = <2>; samsung,pin-pud = <0>; samsung,pin-drv = <1>; };
};

/ {
	mipi_phy_csis_m0s4A: phy_isp_csis0@14510840 {
		compatible = "samsung,mipi-phy-s4";
		reg = <0x00 0x14510840 0x00 0x04>;
		reg_index = <0>;
		samsung,pmu-syscon = <0x03>;
		isolation = <0x0680>;
		reset = <8>;
		#phy-cells = <1>;
		phandle = <0x7f50>;
	};
	mipi_phy_csis_m0s4B: phy_isp_csis1@14510840 {
		compatible = "samsung,mipi-phy-s4";
		reg_index = <0>;
		samsung,pmu-syscon = <0x03>;
		isolation = <0x067c>;
		reset = <16>;
		#phy-cells = <1>;
		phandle = <0x7f51>;
	};
	mipi_phy_csis_m4s2: phy_isp_csis3@14510840 {
		compatible = "samsung,mipi-phy-csis";
		reg_index = <0>;
		samsung,pmu-syscon = <0x03>;
		isolation = <0x0678>;
		reset = <0>;
		#phy-cells = <1>;
		phandle = <0x7f52>;
	};

	fimc_is_sensor@14410000 {
		/* BACK / CSIS1 */
		power-domains = <0x7f10>;
		compatible = "samsung,exynos5-fimc-is-sensor";
		reg = <0x00 0x14410000 0x00 0x10000>;
		interrupts = <0 298 4>;
		phys = <0x7f50 0>;
		phy-names = "csis_dphy";
		clocks = <0x04 0x67>, <0x04 0x68>, <0x04 0x69>,
			 <0x7f12 0xac>, <0x7f12 0xad>, <0x7f12 0xae>, <0x7f12 0xaf>, <0x7f12 0xb0>;
		clock-names = "CIS_CLK0", "CIS_CLK1", "CIS_CLK2",
			"GATE_CAM_CSIS_DMA", "GATE_CAM_CSIS0", "GATE_CAM_CSIS1",
			"GATE_CAM_CSIS2", "GATE_CAM_CSIS3";
		scenario = <0>;
		id = <0>;
		csi_ch = <1>;
		flite_ch = <100>;
		is_bns = <0>;
		is_flite = <0>;
		status = "okay";
	};

	fimc_is_sensor@14400000 {
		/* FRONT / CSIS0 */
		power-domains = <0x7f10>;
		compatible = "samsung,exynos5-fimc-is-sensor";
		reg = <0x00 0x14400000 0x00 0x10000>;
		interrupts = <0 297 4>;
		phys = <0x7f51 0>;
		phy-names = "csis_dphy";
		clocks = <0x04 0x67>, <0x04 0x68>, <0x04 0x69>,
			 <0x7f12 0xac>, <0x7f12 0xad>, <0x7f12 0xae>, <0x7f12 0xaf>, <0x7f12 0xb0>;
		clock-names = "CIS_CLK0", "CIS_CLK1", "CIS_CLK2",
			"GATE_CAM_CSIS_DMA", "GATE_CAM_CSIS0", "GATE_CAM_CSIS1",
			"GATE_CAM_CSIS2", "GATE_CAM_CSIS3";
		scenario = <0>;
		id = <1>;
		csi_ch = <0>;
		flite_ch = <100>;
		is_bns = <0>;
		is_flite = <0>;
		status = "okay";
	};

	fimc_is_sensor@14430000 {
		/* CSIS3 */
		power-domains = <0x7f10>;
		compatible = "samsung,exynos5-fimc-is-sensor";
		reg = <0x00 0x14430000 0x00 0x10000>;
		interrupts = <0 300 4>;
		phys = <0x7f52 0>;
		phy-names = "csis_dphy";
		clocks = <0x04 0x67>, <0x04 0x68>, <0x04 0x69>,
			 <0x7f12 0xac>, <0x7f12 0xad>, <0x7f12 0xae>, <0x7f12 0xaf>, <0x7f12 0xb0>;
		clock-names = "CIS_CLK0", "CIS_CLK1", "CIS_CLK2",
			"GATE_CAM_CSIS_DMA", "GATE_CAM_CSIS0", "GATE_CAM_CSIS1",
			"GATE_CAM_CSIS2", "GATE_CAM_CSIS3";
		scenario = <0>;
		id = <3>;
		csi_ch = <3>;
		flite_ch = <100>;
		is_bns = <0>;
		is_flite = <0>;
		status = "okay";
	};

	fimc-is_sensor_3l6@2D {
		compatible = "samsung,sensor-module-3l6";
		pinctrl-names = "pin0", "pin1", "pin2", "release";
		pinctrl-0 = <0x7f4b>;
		pinctrl-1 = <0x7f4b>;
		pinctrl-2 = <0x7f4c>;
		pinctrl-3 = <>;
		position = <0>;
		id = <0>;
		mclk_ch = <2>;
		sensor_i2c_ch = <1>;
		gpio_mclk = <0x24 2 1>;
		gpio_reset = <0x37 4 1>;
		gpio_camaf_2p8_en = <0x3b 5 1>;
		status = "okay";

		af {
			product_name = <19>;
			i2c_addr = <0x18>;
			i2c_ch = <3>;
		};

		flash {
			product_name = <11>;
			flash_first_gpio = <2>;
			flash_second_gpio = <1>;
		};
	};

	fimc-is_sensor_4ha@6C {
		compatible = "samsung,sensor-module-4ha";
		pinctrl-names = "default", "pin1", "pin2", "release";
		pinctrl-0 = <0x7f49>;
		pinctrl-1 = <0x7f49>;
		pinctrl-2 = <0x7f4a>;
		pinctrl-3 = <>;
		position = <1>;
		id = <1>;
		mclk_ch = <1>;
		sensor_i2c_ch = <0>;
		num_of_lanes = <4>;
		gpio_mclk = <0x24 1 1>;
		gpio_reset = <0x37 5 1>;
		status = "okay";
	};

	fimc-is_sensor_5e9@10 {
		compatible = "samsung,sensor-module-5e9";
		pinctrl-names = "pin0", "pin1", "pin2", "release";
		pinctrl-0 = <0x7f46>;
		pinctrl-1 = <0x7f47>;
		pinctrl-2 = <0x7f48>;
		pinctrl-3 = <>;
		position = <6>;
		id = <3>;
		mclk_ch = <0>;
		sensor_i2c_ch = <2>;
		gpio_mclk = <0x24 0 1>;
		gpio_reset = <0x15 5 1>;
		status = "okay";
	};

	fimc-is-flash_gpio@0 {
		compatible = "samsung,sensor-flash-gpio";
		id = <0>;
		status = "okay";
		flash-gpio = <0x15 7 0>;
		torch-gpio = <0x15 7 0>;
	};

	hsi2c@138A0000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x138a0000 0x00 0x1000>;
		interrupts = <0 257 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default", "on_i2c";
		pinctrl-0 = <0x7f42>;
		pinctrl-1 = <0x7f42>;
		clocks = <0x04 0x3e>;
		clock-names = "hsi2c";
		clock-frequency = <400000>;
		status = "okay";

		fimc-is-4ha@2D {
			compatible = "samsung,exynos5-fimc-is-cis-4ha";
			reg = <0x2D>;
			id = <1>;
			num_of_lanes = <4>;
			sensor_f_number = <200>;
			setfile = "setB";
			use_initial_ae;
		};
	};

	hsi2c@138B0000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x138b0000 0x00 0x1000>;
		interrupts = <0 258 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default", "on_i2c";
		pinctrl-0 = <0x7f43>;
		pinctrl-1 = <0x7f43>;
		clocks = <0x04 0x3f>;
		clock-names = "hsi2c";
		clock-frequency = <400000>;
		status = "okay";

		fimc-is-3l6@2D {
			compatible = "samsung,exynos5-fimc-is-cis-3l6";
			reg = <0x2D>;
			id = <0>;
			sensor_f_number = <190>;
			setfile = "setB";
		};
	};

	hsi2c@138C0000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x138c0000 0x00 0x1000>;
		interrupts = <0 259 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default", "on_i2c";
		pinctrl-0 = <0x7f44>;
		pinctrl-1 = <0x7f44>;
		clocks = <0x04 0x40>;
		clock-names = "hsi2c";
		clock-frequency = <400000>;
		status = "okay";

		fimc-is-5e9@10 {
			compatible = "samsung,exynos5-fimc-is-cis-5e9";
			reg = <0x10>;
			id = <3>;
			sensor_f_number = <220>;
			setfile = "setB";
		};
	};

	hsi2c@138D0000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x138d0000 0x00 0x1000>;
		interrupts = <0 260 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default", "on_i2c";
		pinctrl-0 = <0x7f45>;
		pinctrl-1 = <0x7f45>;
		clocks = <0x04 0x41>;
		clock-names = "hsi2c";
		clock-frequency = <400000>;
		status = "okay";

		rear_eeprom@58 {
			compatible = "samsung,rear-eeprom-i2c";
			reg = <0x58>;
		};

		front_eeprom@51 {
			compatible = "samsung,front-eeprom-i2c";
			reg = <0x51>;
		};

		fimc-is-actuator@0C {
			compatible = "samsung,exynos5-fimc-is-actuator-dw9808";
			reg = <0x0C>;
			id = <0>;
			place = <0>;
		};
	};
};

/* Rear wide-angle calibration bus, as wired in the M20 4.4 board DT. */
&{/pinctrl@139b0000} {
	cam_hs_i2c6_bus: cam-hs-i2c6-bus {
		phandle = <0x7f53>;
		samsung,pins = "gpc2-5", "gpc2-4";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <3>;
	};
};

/ {
	hsi2c@13940000 {
		compatible = "samsung,exynos7885-hsi2c", "samsung,exynos7-hsi2c";
		samsung,check-transdone-int;
		reg = <0x00 0x13940000 0x00 0x1000>;
		interrupts = <0 271 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default", "on_i2c";
		pinctrl-0 = <0x7f53>;
		pinctrl-1 = <0x7f53>;
		clocks = <0x04 0x3f>;
		clock-names = "hsi2c";
		samsung,usi-i-mode = <0x10032004>;
		clock-frequency = <400000>;
		status = "okay";

		rear3_eeprom@50 {
			compatible = "samsung,rear3-eeprom-i2c";
			reg = <0x50>;
		};
	};
};

/* RT8547 flash controller: board currents and GPIOs from the 4.4 M20 DT. */
/ {
	leds_rt8547 {
		compatible = "rt8547";
		status = "okay";
		flash_control = <0x7f40 1 1>;
		flash_en = <0x15 7 1>;
		flash_current = <1500>;
		movie_current = <200>;
		factory_current = <350>;
		pre_current = <275>;
	};
};


/* Still-image JPEG and scaler: Exynos7885 MFCMSCL register/IRQ topology. */
/ {
	aliases {
		jpeg0 = "/jpeg@12c00000";
		scaler0 = "/scaler@12c10000";
		mfc0 = "/mfc0@12c30000";
	};

	power-domain@11c84040 {
		compatible = "samsung,exynos7885-mfcmscl-pd";
		reg = <0 0x11c84040 0 0x20>;
		#power-domain-cells = <0>;
		samsung,pmu = <0x03>;
		phandle = <0x7f61>;
		status = "okay";
	};

	clock-controller@12cb0000 {
		compatible = "samsung,exynos7885-cmu-mfcmscl";
		reg = <0 0x12cb0000 0 0x8000>;
		#clock-cells = <1>;
		power-domains = <0x7f61>;
		phandle = <0x7f60>;
		status = "okay";
	};

	sysmmu@12c50000 {
		compatible = "samsung,exynos7885-sysmmu";
		reg = <0 0x12c50000 0 0x9000>;
		interrupts = <0 198 4>, <0 199 4>;
		clock-names = "aclk";
		clocks = <0x7f60 14>;
		power-domains = <0x7f61>;
		qos = <15>;
		port-name = "MFCMSCL (G2D, JPEG, scaler, MFC)";
		#iommu-cells = <0>;
		phandle = <0x7f62>;
		status = "okay";
	};

	jpeg@12c00000 {
		compatible = "samsung,exynos7904-jpeg";
		reg = <0 0x12c00000 0 0x1000>;
		interrupts = <0 194 4>;
		clocks = <0x7f60 11>;
		clock-names = "gate";
		iommus = <0x7f62>;
		power-domains = <0x7f61>;
		status = "okay";
	};

	/*
	 * 4.4 fimg2d@12C20000: G2D 2D engine behind the shared MFCMSCL SysMMU.
	 * The HWC libacryl opens /dev/fimg2d for M2M composition; without it
	 * every layer fell back to GPU (client) composition.
	 */
	fimg2d@12c20000 {
		compatible = "samsung,s5p-fimg2d";
		reg = <0 0x12c20000 0 0x1000>;
		interrupts = <0 196 4>;
		clocks = <0x7f60 10>;
		clock-names = "gate";
		iommus = <0x7f62>;
		power-domains = <0x7f61>;
		hw_ppc = <0x578 0x4b0 0x76c>;
		skia_qos_table = <0x00 0x00 0xf78f0 0x00 0x00 0xf78f0 0x00 0x00 0xce4c8 0x00 0x00 0xce4c8 0x00 0x00 0xa50a0 0x00 0x00 0x00>;
		status = "okay";
	};

	scaler@12c10000 {
		compatible = "samsung,exynos5-scaler";
		reg = <0 0x12c10000 0 0x2000>;
		interrupts = <0 195 4>;
		clocks = <0x7f60 13>;
		clock-names = "gate";
		iommus = <0x7f62>;
		power-domains = <0x7f61>;
		status = "okay";
	};

	/* MFC v6.x video codec; values from 4.4 exynos7885.dtsi mfc_0. */
	mfc0@12c30000 {
		compatible = "samsung,mfc-v6";
		reg = <0 0x12c30000 0 0x10000>;
		interrupts = <0 197 4>;
		clocks = <0x7f60 12>;
		clock-names = "aclk_mfc";
		iommus = <0x7f62>;
		power-domains = <0x7f61>;
		status = "okay";
		ip_ver = <16>;
		clock_rate = <533000>;
		min_rate = <89000>;
		num_qos_steps = <3>;
		max_mb = <1511155>;
		mfc_qos_table {
			mfc_qos_variant_0 {
				thrd_mb = <0>;
				freq_mfc = <267000>;
				freq_int = <267000>;
				freq_mif = <420000>;
				freq_cpu = <0>;
				freq_kfc = <0>;
				mo_value = <0>;
				time_fw = <262>;
			};
			mfc_qos_variant_1 {
				thrd_mb = <250519>;
				freq_mfc = <333000>;
				freq_int = <333000>;
				freq_mif = <546000>;
				freq_cpu = <0>;
				freq_kfc = <0>;
				mo_value = <0>;
				time_fw = <213>;
			};
			mfc_qos_variant_2 {
				thrd_mb = <511481>;
				freq_mfc = <533000>;
				freq_int = <533000>;
				freq_mif = <1352000>;
				freq_cpu = <0>;
				freq_kfc = <0>;
				mo_value = <0>;
				time_fw = <123>;
			};
		};
	};
};

/* 4.4 pinctrl@13430000 sleep-state: power-down (PDN) pin config only, no mux. */
&{/pinctrl@13430000} {
	pinctrl-names = "default";
	pinctrl-0 = <0x1f4>;

	m20-sleep-state {
		phandle = <0x1f4>;

		gpf0-0 {
			samsung,pins = "gpf0-0";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf0-1 {
			samsung,pins = "gpf0-1";
			samsung,pin-con-pdn = <0x01>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf0-2 {
			samsung,pins = "gpf0-2";
			samsung,pin-con-pdn = <0x02>;
			samsung,pin-pud-pdn = <0x01>;
		};
		gpf0-3 {
			samsung,pins = "gpf0-3";
			samsung,pin-con-pdn = <0x03>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-0 {
			samsung,pins = "gpf2-0";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-1 {
			samsung,pins = "gpf2-1";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-2 {
			samsung,pins = "gpf2-2";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-3 {
			samsung,pins = "gpf2-3";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-4 {
			samsung,pins = "gpf2-4";
			samsung,pin-con-pdn = <0x00>;
			samsung,pin-pud-pdn = <0x00>;
		};
		gpf2-5 {
